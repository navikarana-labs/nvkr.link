RewriteEngine On

# Permanent redirects.
RewriteRule ^$ https://navikarana.io/ [R=301,L]
RewriteRule ^ananta/?$ https://navikarana.io/projects/001-ananta/ [R=301,L]
RewriteRule ^001/?$ https://navikarana.io/projects/001-ananta/ [R=301,L]
RewriteRule ^github/?$ https://github.com/navikarana-labs [R=301,L]
RewriteRule ^contact/?$ https://navikarana.io/contact/ [R=301,L]
RewriteRule ^projects/?$ https://navikarana.io/projects/ [R=301,L]
RewriteRule ^about/?$ https://navikarana.io/about/ [R=301,L]
RewriteRule ^writing/?$ https://loke.sh/tags/navikarana-labs/ [R=301,L]
RewriteRule ^newsletter/?$ https://loke.sh/blog/newsletter/ [R=301,L]
RewriteRule ^ideas/?$ https://forms.gle/YA8YdPBvDRLEQEbV8 [R=301,L]

ErrorDocument 404 /404.html
